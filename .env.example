# Copie para .env.local e preencha. Nenhuma é obrigatória na fase 0:
# sem elas o jogo roda offline, com saves só no aparelho e textos de fallback.

# Supabase (login e backup dos saves) — valores públicos, vão para o navegador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Provedor de LLM (fase 7) — SÓ no servidor, nunca com prefixo NEXT_PUBLIC_
LLM_API_KEY=
